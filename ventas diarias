-- REPORTE FINAL
SELECT 
    Fecha,
    VentaDelDia,
    SUM(VentaDelDia) OVER (ORDER BY Fecha) AS VentaAcumulada,
    MetaDelMes,
    CAST(SUM(VentaDelDia) OVER (ORDER BY Fecha) * 100.0 / MetaDelMes AS DECIMAL(5,2)) AS PorcentajeAvance,
    MetaDelMes - SUM(VentaDelDia) OVER (ORDER BY Fecha) AS FaltaParaMeta
FROM VentasDiarias
ORDER BY Fecha;
